# ============================================================
# JASHUVA GAMES — Environment Configuration
# Copy to .env and fill in production values
# ============================================================

NODE_ENV=development
APP_NAME=JASHUVA GAMES
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://jashuva:jashuva_secret@localhost:5432/jashuva_games?schema=public
REDIS_URL=redis://localhost:6379

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-cookie-secret
SESSION_TIMEOUT_MS=1800000

# SUPER OWNER (created only on first deployment)
OWNER_NAME=Jashuva
OWNER_EMAIL=jashuvawork@gmail.com
OWNER_PASSWORD=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Ads / Analytics / AdSense
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_MULTI=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_ANALYTICS_ID=
# YouTube Data API (optional — used only after owner approval to upload)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Never auto-launch Google Ads; drafts export from Owner Publisher only
GOOGLE_ADS_CUSTOMER_ID=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jashuvagames.com

# Cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CDN_URL=

# Captcha
CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# AI
OPENAI_API_KEY=
AI_ENABLED=true

# Backups
BACKUP_ENCRYPTION_KEY=
BACKUP_PATH=./backups

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
